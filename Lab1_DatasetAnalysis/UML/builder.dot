digraph Builder {
 graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.45", ranksep="0.7", fontname="Arial", labelloc=t, label="Паттерн Builder — пошаговое создание запроса анализа", fontsize=18];
 node [shape=record, style="rounded,filled", fillcolor="#EAF7EF", color="#3E7A5A", fontname="Arial", fontsize=10, margin="0.12,0.08"];
 edge [fontname="Arial", fontsize=9, color="#53657A", arrowsize=0.8];
 Director [label="{AnalysisRequestDirector|+ CreateFullAnalysis()\l + CreateRevenuePreview()\l}", fillcolor="#DDF2E5"];
 Builder [label="{AnalysisRequestBuilder| - filePath\l - includeStatistics\l - filter\l|+ FromFile()\l + IncludeStatistics()\l + WithNumericFilter()\l + Build()\l}", fillcolor="#DDF2E5"];
 Product [label="{AnalysisRequest|+ FilePath\l + IncludeStatistics\l + Filter\l}"];
 Client [label="{Program|+ Main()\l}", fillcolor="#F2F4F7"];
 Director -> Builder [label="директивно задаёт шаги"];
 Client -> Builder [label="может настраивать напрямую"];
 Builder -> Product [label="Build() создаёт"];
}
