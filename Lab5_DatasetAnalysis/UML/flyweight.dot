digraph Flyweight {
 graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.7", fontname="Arial", labelloc=t, label="Паттерн Flyweight — повторное использование стилей столбцов", fontsize=18];
 node [shape=record, style="rounded,filled", fillcolor="#FDECEC", color="#A45B5B", fontname="Arial", fontsize=10, margin="0.12,0.08"];
 edge [fontname="Arial", fontsize=9, color="#53657A", arrowsize=0.8];
 Factory [label="{ColumnStyleFactory| - cache: Dictionary<ColumnDataKind, ColumnStyle>\l|+ GetStyle(kind)}", fillcolor="#F9DADA"];
 Flyweight [label="{ColumnStyle|+ Kind\l + Symbol\l + Description\l}"];
 Context [label="{ColumnStyleRenderer|+ Render(report)}"];
 External [label="{ColumnSummary|+ Name\l + MissingCount\l + статистики\l}", fillcolor="#E8F5EC"];
 Client [label="{Program|+ Main()}", fillcolor="#F2F4F7"];
 Client -> Context; Context -> Factory [label="получает общий стиль"];
 Factory -> Flyweight [label="создаёт и кэширует"];
 Context -> External [label="передаёт внешнее состояние"];
}
