digraph Facade {
 graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.7", fontname="Arial", labelloc=t, label="Паттерн Facade — единая точка запуска анализа CSV", fontsize=18];
 node [shape=record, style="rounded,filled", fillcolor="#FDECEC", color="#A45B5B", fontname="Arial", fontsize=10, margin="0.12,0.08"];
 edge [fontname="Arial", fontsize=9, color="#53657A", arrowsize=0.8];
 Client [label="{Program|+ Main()}", fillcolor="#F2F4F7"];
 Facade [label="{DatasetAnalysisFacade|+ AnalyzeCsv(path, filter)}", fillcolor="#F9DADA"];
 Reader [label="{CsvDatasetReader|+ Load()}"];
 Validator [label="{DatasetValidator|+ Validate()}"];
 Analyzer [label="{DatasetAnalyzer|+ FilterNumeric()\l + Analyze()}"];
 Exporter [label="{CsvDatasetExporter|+ Export()}"];
 Client -> Facade [label="один вызов"];
 Facade -> Reader; Facade -> Validator; Facade -> Analyzer; Facade -> Exporter;
}
