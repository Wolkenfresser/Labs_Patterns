digraph Decorator {
 graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.7", fontname="Arial", labelloc=t, label="Паттерн Decorator — динамическое расширение аналитического отчёта", fontsize=18];
 node [shape=record, style="rounded,filled", fillcolor="#E7F5F4", color="#3A827C", fontname="Arial", fontsize=10, margin="0.12,0.08"];
 edge [fontname="Arial", fontsize=9, color="#53657A", arrowsize=0.8];
 I [label="{IAnalysisReportFormatter|+ Format(report)}", fillcolor="#D5EFED"];
 Basic [label="{BasicReportFormatter|+ Format(report)}"];
 Base [label="{ReportFormatterDecorator| - Inner: IAnalysisReportFormatter\l|+ Format(report)}", fillcolor="#D5EFED"];
 Missing [label="{MissingValuesDecorator|+ Format(report)}"];
 Numeric [label="{NumericStatisticsDecorator|+ Format(report)}"];
 I -> Basic [arrowhead=empty]; I -> Base [arrowhead=empty];
 Base -> Missing [arrowhead=empty]; Base -> Numeric [arrowhead=empty];
 Base -> I [label="оборачивает", arrowhead=odiamond];
}
